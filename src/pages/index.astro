---
const shopName="Apex Garage";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{shopName} | Performance Tuning Sydney </title>
	</head>
	<body>
		<section class="hero">
			<h1>{shopName}</h1>
			<p>Performance tuning and servicing in Sydney.</p>
			<div class="actions">
				<a href="#book" class="btn">Book a Visit</a>
				<a href="sms:+61400000000" class="btn btn-outline">Chat to Us</a>
			</div>
		</section>
		<section class="services">
			<h2>Our Services</h2>
			<div class="grid">
				<div class="card tall">
				<img src="/images/tuning.avif" alt="Porsche GT3 RS on a hoist" />
				<h3>Tuning and Dyno</h3>
				<p>Custom ECU tunes with before and after dyno results.</p>
				</div>
			<div class="card tall">
				<img src="/images/servicing.avif" alt="Classic supercars in a workshop" />
				<h3>Custom Builds</h3>
				<p>From mild street setups to full track builds.</p>
			</div>
			<div class="card wide">
					<img src="/images/builds.avif" alt="Cars being serviced in a workshop" />
					<h3>Servicing</h3>
					<p>Logbook servicing, brakes, pink slips, and repairs.</p>
			</div>
			</div>
		</section>
	</body>
</html>

<style>
	body {
		margin: 0;
		background-color: #0a0a0a;
		color: white;
		font-family: system-ui, sans-serif;
	}


.hero {
	min-height: 66vh;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	text-align: center;
	background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.85)), url('/images/hero.avif');
	background-size: cover;
	background-position: center 20%;
}
h1 {
	font-size: 4rem;
	text-transform: uppercase;
}

.btn {
	background-color: #e10600;
	color: white;
	padding: 1rem 2rem;
	text-decoration: none;
	font-weight: bold;
	border: 2px solid #e10600;
	border-radius: 8px;
}
.services {
	padding: 4rem 2rem;
	max-width: 1200px;
	margin: 0 auto;
}
h2 {
	font-family: "Bebas Neue", sans-serif;
	font-size: 3rem;
	text-align: center;
}
.grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 1.5rem;
}
.card {
	background: #151515;
	border-top: 3px solid #e10600;
}
.card img {
	width: 100%;
	height: 400px;
	object-fit: cover;
	display: block;
}
.card h3 {
	margin: 0;
	padding: 1rem 1rem 0;
	text-transform: uppercase
}
.card p {
	padding: 0 1rem 1.5rem;
	color: #bbbbbb;
}
.card p {
	padding: 0 1re, 1.5rem;
	color: #bbbbbb;
}
.card.wide {
	grid-column: 1 / -1;;
}
.card.wide img {
	height: 350px;
}
.card.tall img {
	height: 600px;
}
@media (max-width:700px) {
	.grid {
		grid-template-columns: 1fr;
	}
	card.tall img {
		height: 450px;
	}
}
.btn-outline {
	background-color: rgba(255, 6, 0, 0.35);
	border: 2px solid #e10600;
	background-filter: blur(6px);
}
.actions {
	display: flex;
	gap: 1rem;
	flex-wrap: wrap;
	Justify-content: center;
	margin-top: 1rem;
}
</style>

