---
import Layout from '../layouts/Layout.astro';
const shopName="Apex Garage";
---

<Layout title={`${shopName} | Performance Tuning Sydney`}>
	<section class="hero">
			<h1>{shopName}</h1>
			<p>Performance tuning and servicing in Sydney.</p>
			<div class="actions">
				<a href="#book" class="btn">Book a Visit</a>
				<a href="sms:+61400000000" class="btn btn-outline">Chat to Us</a>
			</div>
		</section>
		<section class="services" id="services">
			<h2>Built to Perform</h2>
			<div class="grid">
				<div class="card tall">
				<img src="/images/tuning.avif" alt="Porsche GT3 RS on a hoist" />
				<h3>Tuning and Dyno</h3>
				<p>Custom ECU tunes with before and after dyno results.</p>
				</div>
			<div class="card tall">
				<img src="/images/servicing.avif" alt="Classic supercars in a workshop" />
				<h3>Custom Builds</h3>
				<p>From mild street setups to full track builds.</p>
			</div>
			<div class="card wide">
					<img src="/images/builds.avif" alt="Cars being serviced in a workshop" />
					<h3>Servicing</h3>
					<p>Logbook servicing, brakes, pink slips, and repairs.</p>
			</div>
			</div>
		</section>
</Layout>

<style>
.hero {
	min-height: 66vh;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	text-align: center;
	background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.85)), url('/images/hero.avif');
	background-size: cover;
	background-position: center 20%;
}
h1 {
	font-family: "Bebas Neue", sans-serif;
	font-size: 7rem;
	letter-spacing: 0.05em;
	margin: 0;
}

.btn {
	background-color: #e10600;
	color: white;
	padding: 1rem 2rem;
	text-decoration: none;
	font-weight: bold;
	border: 2px solid #e10600;
	border-radius: 8px;
	transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}
.services {
	padding: 4rem 2rem;
	max-width: 1200px;
	margin: 0 auto;
}
h2 {
	font-family: "Bebas Neue", sans-serif;
	font-size: 3rem;
	text-align: center;
}
.grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	column-gap: 3rem;
	row-gap: 2rem;
}
.card {
	background: #151515;
	border-top: 3px solid #e10600;
}
.card img {
	width: 100%;
	height: 400px;
	object-fit: cover;
	display: block;
}
.card h3 {
	margin: 0;
	padding: 1rem 1rem 0;
	text-transform: uppercase;
}
.card p {
	padding: 0 1rem 1.5rem;
	color: #bbbbbb;
}
.card.wide {
	grid-column: 1 / -1;
}
.card.wide img {
	height: 350px;
}
.card.tall img {
	height: 600px;
}
@media (max-width:700px) {
	.grid {
		grid-template-columns: 1fr;
	}
	.card.tall img {
		height: 450px;
	}
}
.btn-outline {
	background-color: rgba(225, 6, 0, 0.35);
	border: 2px solid #e10600;
	backdrop-filter: blur(6px);
}
.actions {
	display: flex;
	gap: 1rem;
	flex-wrap: wrap;
	justify-content: center;
	margin-top: 1rem;
}

.btn:hover {
	transform: translateY(-3px);
	background-color: rgba(225, 6, 0, 0.35);
	backdrop-filter: blur(6px);
	box-shadow: 0 8px 20px rgba(225, 6, 0, 0.4);
}
.btn-outline:hover {
	background-color: rgba(225, 6, 0, 0.6);
}
</style>

