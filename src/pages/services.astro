---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Services | Apex Garage">
	<section class="page-header">
		<p class="eyebrow">What we do</p>
		<h1>Our Services</h1>
	</section>
</Layout>

<style>
	.page-header {
		max-width: 1200px;
		margin: 0 auto;
		padding: 8rem 2rem 2rem;
	}
	.eyebrow {
		color: #e10600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.8rem;
		font-weight: bold;
		margin: 0;
	}
	h1 {
		font-family: "Bebas Neue", sans-serif;
		font-size: 4rem;
		margin: 0.5rem 0 0;
	}
</style>
