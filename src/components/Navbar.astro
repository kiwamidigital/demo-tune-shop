---
const links = [
    {label: "Home", href: "/"},
    {label: "Services", href: "/services"},
    {label: "Builds", href: "/#builds"},
    {label: "About", href: "/#about"},
    {label: "Contact", href: "/#contact"},
];
---

<header class="navbar">
    <a href="/" class="logo">APEX <span> GARAGE</span></a>
    <nav>
        <ul>
            {links.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <a href="#book" class="nav-cta">Book a Visit</a>
</header>


<style>

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.5rem;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
}
.navbar.hidden {
    transform: translateY(-100%);
}
.navbar.scrolled {
    background-color: rgba(31, 31, 31, 0.95);
    backdrop-filter: blur(8px);
    border-bottom-color: #2e2e2e;
}
.logo {
    font-family: "Bebas Neue", sans-serif;
    font-size: 2rem;
    letter-spacing: 0.05em;
    color: white;
    text-decoration: none;
}
.logo span {
    color: #e10600;
}
nav ul {
    display: flex;
    gap: 2.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
}
nav a {
    color: white;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    transition: color 0.2s ease;
}
nav a:hover {
    color: #e10600;
}
.nav-cta {
    background-color: #e10600;
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: bold;
}
@media (max-width: 800px) {
    nav {
    display: none;
    }
}
</style>

<script>
    const navbar = document.querySelector<HTMLElement>(".navbar");
    const buttons = document.querySelector<HTMLElement>(".hero .actions");

    function updateNavbar() {
        if (!navbar) return;

        // Pages without a hero: always show the solid navbar
        if (!buttons) {
            navbar.classList.add("scrolled");
            return;
        }

        // Have the hero buttons scrolled up under the navbar yet?
        const pastButtons = buttons.getBoundingClientRect().bottom < navbar.offsetHeight;
        const atTop = window.scrollY < 10;

        navbar.classList.toggle("scrolled", pastButtons);
        navbar.classList.toggle("hidden", !atTop && !pastButtons);
    }

    window.addEventListener("scroll", updateNavbar);
    updateNavbar();
</script>
